# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any other .env file (they are ignored by git).
#
# Supabase project (Project Settings → API). The anon key is public by design;
# NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Google Places autocomplete in Backoffice → Lieux → Ajouter.
# Restrict the key to your domains and to the Places API in Google Cloud.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
# Optional: canonical site address (defaults to https://www.kinshasalabel.com).
NEXT_PUBLIC_SITE_URL=
