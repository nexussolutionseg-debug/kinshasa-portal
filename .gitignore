# dependencies
/node_modules

# next.js build output
/.next/
/out/

# production
/build

# env files (never commit real secrets — see .env.example instead)
.env*
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/

# generated from node_modules at build time (scripts/copy-maplibre-worker.mjs)
/public/maplibre/

# Vercel CLI link + local build output
/.vercel/
/coverage/
/dist/

# uploads / archives that must never land in the repo
*.zip
*.bundle
*.tar
*.tar.gz
*.rar
*.sql.gz
*.dump
