{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Kinshasa Label brand tokens, extracted from the live code (tailwind.config.ts, src/lib/categories.ts, src/lib/traffic.ts, src/lib/mapStyle.ts) on 2026-10-08. Values are exactly what the site uses today.",
  "color": {
    "core": {
      "blue":        { "$type": "color", "$value": "#1A82F5", "$description": "Primary blue. Logo wheel and tower, links, primary blue buttons, browser theme colour." },
      "blue-deep":   { "$type": "color", "$value": "#0E5FC9", "$description": "Blue text on white, gradient ends, hover." },
      "blue-soft":   { "$type": "color", "$value": "#E6F1FF", "$description": "Blue chips and light panels." },
      "navy":        { "$type": "color", "$value": "#0A2A66", "$description": "Deep hero gradients, Kin Sécurité." },
      "red":         { "$type": "color", "$value": "#D21C2E", "$description": "Primary red. Logo 'K', main call-to-action buttons, the word 'Label', live dot." },
      "red-dark":    { "$type": "color", "$value": "#A60E1D", "$description": "Red hover, Kin Actualité hero gradient." },
      "red-soft":    { "$type": "color", "$value": "#FDE8EA", "$description": "Red chips." },
      "yellow":      { "$type": "color", "$value": "#FCD933", "$description": "Logo yellow (sun-pin, gondolas), highlights in heroes." },
      "yellow-deep": { "$type": "color", "$value": "#B98A00", "$description": "Yellow-family text on white (readable), Kin Culture." },
      "yellow-soft": { "$type": "color", "$value": "#FFF7D1", "$description": "Light yellow panels (exchange-rate card)." }
    },
    "neutral": {
      "bg":      { "$type": "color", "$value": "#F5F8FE", "$description": "Page background." },
      "surface": { "$type": "color", "$value": "#FFFFFF", "$description": "Cards, header, footer." },
      "line":    { "$type": "color", "$value": "#DCE5F3", "$description": "Borders and dividers." },
      "ink":     { "$type": "color", "$value": "#0B2545", "$description": "Main text; dark backgrounds." },
      "muted":   { "$type": "color", "$value": "#5E6E86", "$description": "Secondary text." }
    },
    "category": {
      "kin-actualite": { "color": { "$type": "color", "$value": "#D21C2E" }, "soft": { "$type": "color", "$value": "#FDE8EA" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#0A2A66 0%,#1A82F5 100%)" } },
      "kin-food":      { "color": { "$type": "color", "$value": "#D21C2E" }, "soft": { "$type": "color", "$value": "#FDE8EA" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#FF6B5A 0%,#D21C2E 100%)" } },
      "kin-places":    { "color": { "$type": "color", "$value": "#1A82F5" }, "soft": { "$type": "color", "$value": "#E6F1FF" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#4BA3F7 0%,#0E5FC9 100%)" } },
      "kin-culture":   { "color": { "$type": "color", "$value": "#B98A00" }, "soft": { "$type": "color", "$value": "#FFF7D1" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#FFE36B 0%,#F5B400 100%)" }, "map-pin": { "$type": "color", "$value": "#E5A800" } },
      "kin-style":     { "color": { "$type": "color", "$value": "#C2185B" }, "soft": { "$type": "color", "$value": "#FCE4EF" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#F06292 0%,#C2185B 100%)" } },
      "kin-securite":  { "color": { "$type": "color", "$value": "#0A2A66" }, "soft": { "$type": "color", "$value": "#E3E9F5" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#3B5BA9 0%,#0A2A66 100%)" } },
      "kin-traffic":   { "color": { "$type": "color", "$value": "#E8590C" }, "soft": { "$type": "color", "$value": "#FFEADB" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#FFA94D 0%,#E8590C 100%)" } },
      "kin-weekend":   { "color": { "$type": "color", "$value": "#7B3FE4" }, "soft": { "$type": "color", "$value": "#EFE6FD" }, "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg,#9D6BFF 0%,#5B21B6 100%)" } }
    },
    "status": {
      "traffic-heavy":    { "$type": "color", "$value": "#D21C2E" },
      "traffic-moderate": { "$type": "color", "$value": "#F5B400" },
      "traffic-light":    { "$type": "color", "$value": "#22A45D" },
      "danger":           { "$type": "color", "$value": "#D21C2E", "$description": "Same value as brand red today (see BRAND.md, inconsistencies)." }
    },
    "flag-strip": { "$type": "gradient", "$value": "linear-gradient(90deg,#1A82F5 0 33.3%,#FCD933 33.3% 66.6%,#D21C2E 66.6% 100%)", "$description": "Three-colour strip at the top of the header and footer." }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Outfit Variable", "Outfit", "system-ui", "sans-serif"], "$description": "Headings, wordmark, buttons. Variable font, weights 100–900; the site uses 600 (semibold), 700 (bold) and 800 (extrabold). Self-hosted from @fontsource-variable/outfit (SIL Open Font License)." },
    "body":    { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"], "$description": "Body text: the device's own system font." }
  },
  "radius": {
    "chip": { "$type": "dimension", "$value": "9999px" },
    "card": { "$type": "dimension", "$value": "24px" },
    "hero": { "$type": "dimension", "$value": "28px" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 1px 2px rgba(11,37,69,0.06), 0 8px 24px -12px rgba(11,37,69,0.18)" },
    "lift": { "$type": "shadow", "$value": "0 2px 4px rgba(11,37,69,0.06), 0 18px 40px -16px rgba(11,37,69,0.30)" }
  }
}
